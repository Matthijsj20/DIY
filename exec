#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
Usage: ./exec <command> [-p <project>] [options]

Commands:
  build     Compile firmware
  upload    Build and upload to the device
  monitor   Open the serial monitor
  compiledb Refresh IDE IntelliSense (compile_commands.json + shared paths)

Projects (-p, --project):
  bell      Doorbell detector (bell/)
  buzzer    Doorbell buzzer (buzzer/)

Examples:
  ./exec build -p buzzer
  ./exec upload --project bell
  ./exec monitor
  ./exec compiledb

Options:
  -p, --project <name>   Required for build/upload. Optional for compiledb.
  -h, --help             Show this help
EOF
}

find_pio() {
  if command -v pio >/dev/null 2>&1; then
    command -v pio
    return
  fi
  if command -v platformio >/dev/null 2>&1; then
    command -v platformio
    return
  fi
  if [[ -x "${HOME}/.platformio/penv/bin/pio" ]]; then
    echo "${HOME}/.platformio/penv/bin/pio"
    return
  fi
  echo "Error: PlatformIO (pio) not found. Install from https://platformio.org or add it to PATH." >&2
  exit 1
}

to_lower() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

resolve_project_dir() {
  local name
  name="$(to_lower "$1")"
  case "$name" in
    bell) echo "$ROOT/bell" ;;
    buzzer) echo "$ROOT/buzzer" ;;
    *)
      echo "Error: unknown project '$1'. Use 'bell' or 'buzzer'." >&2
      exit 1
      ;;
  esac
}

COMMAND=""
PROJECT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    build|upload|monitor|compiledb)
      if [[ -n "$COMMAND" ]]; then
        echo "Error: only one command allowed." >&2
        exit 1
      fi
      COMMAND="$1"
      ;;
    -p|--project)
      shift
      if [[ $# -eq 0 ]]; then
        echo "Error: -p/--project requires a value." >&2
        exit 1
      fi
      PROJECT="$1"
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Error: unknown argument '$1'." >&2
      usage >&2
      exit 1
      ;;
  esac
  shift
done

if [[ -z "$COMMAND" ]]; then
  echo "Error: missing command (build, upload, monitor, or compiledb)." >&2
  usage >&2
  exit 1
fi

if [[ -z "$PROJECT" && "$COMMAND" != "compiledb" && "$COMMAND" != "monitor" ]]; then
  echo "Error: missing project. Use -p bell or -p buzzer." >&2
  usage >&2
  exit 1
fi

if [[ -n "$PROJECT" && "$COMMAND" == "monitor" ]]; then
  echo "Error: monitor does not take a project. Use: ./exec monitor" >&2
  exit 1
fi

PIO="$(find_pio)"

case "$COMMAND" in
  build)
    PROJECT_DIR="$(resolve_project_dir "$PROJECT")"
    exec "$PIO" run -d "$PROJECT_DIR"
    ;;
  upload)
    PROJECT_DIR="$(resolve_project_dir "$PROJECT")"
    exec "$PIO" run -d "$PROJECT_DIR" -t upload
    ;;
  monitor)
    exec "$PIO" device monitor -b 115200
    ;;
  compiledb)
    if [[ -n "$PROJECT" ]]; then
      PROJECT_DIR="$(resolve_project_dir "$PROJECT")"
      exec "$PIO" run -d "$PROJECT_DIR" -t compiledb
    fi
    exec python3 "$ROOT/scripts/refresh-intellisense.py"
    ;;
esac
